generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id Int @id@default(autoincrement())
  username String @unique
  password String
  email String?
  profile profile?
}

model profile {
  id Int @id@default(autoincrement())
  displayName String?
  profilePic String?
  bio String?
  userId Int @unique
  user user @relation(fields : [userId], references: [id])
  followers profile[] @relation("userFollows")
  following profile[] @relation("userFollows")
  post post[]
  liked post[] @relation("like")
  disliked post[] @relation("dislike")
  comments_liked comment[] @relation("comment likes")
  comments comment[]
  replies_liked reply[] @relation("reply likes")
  replies reply[]
}

model post {
  id Int @id@default(autoincrement())
  content String
  attachment String?
  attachmentType String?
  uploaded_at DateTime @default(now())
  profile profile @relation(fields : [profileId], references: [id])
  profileId Int
  category category[] @relation("postCategory")
  likes profile[] @relation("like")
  dislikes profile[] @relation("dislike")
  comments comment[]
}

model category {
  id Int @id@default(autoincrement())
  name String @unique
  post post[] @relation("postCategory")
}

model comment {
  id Int @id@default(autoincrement())
  commented_at DateTime @default(now())
  content String
  likes profile[] @relation("comment likes")
  post post @relation(fields : [postId], references: [id], onDelete : Cascade)
  postId Int
  profile profile @relation(fields : [profileId], references: [id])
  profileId Int
  replies reply[]
}

model reply {
  id Int @id@default(autoincrement())
  commentId Int
  comment comment @relation(fields: [commentId], references: [id], onDelete : Cascade)
  commented_at DateTime @default(now())
  likes profile[] @relation("reply likes")
  content String
  profileId Int
  profile profile @relation(fields : [profileId], references: [id])
}